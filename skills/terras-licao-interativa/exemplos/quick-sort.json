          "codigo": {
            "titulo": "Pseudocódigo",
            "linhas": [
              "quick_sort(a, lo, hi):",
              "  se lo >= hi: retorna",
              "  p = particiona(a, lo, hi)",
              "  quick_sort(a, lo, p - 1)",
              "  quick_sort(a, p + 1, hi)",
              "",
              "particiona(a, lo, hi):",
              "  pivo = a[hi]",
              "  i = lo",
              "  para j de lo até hi - 1:",
              "    se a[j] < pivo:",
              "      troca(a[i], a[j])",
              "      i = i + 1",
              "  troca(a[i], a[hi])",
              "  retorna i"
            ]
