# terras-ebook — copie este arquivo para `.env` (na mesma pasta dos scripts) e preencha.
# Nada aqui é obrigatório para as duas rotas; veja o que cada etapa pede no SKILL.md.

# --- Rota A: automação completa ---------------------------------------------

# YouTube Data API v3 — GRÁTIS. Crie em https://console.cloud.google.com/apis/credentials
# e habilite "YouTube Data API v3".
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supadata — transcrição PAGA, com cota gratuita: https://supadata.ai
# Só entra em cena quando o caminho grátis (youtube-transcript-api) falha.
SUPADATA_API_KEY=your_supadata_api_key_here

# API da Anthropic — COBRADA POR USO, separada da assinatura do ZCode.
# https://console.anthropic.com/ ; na rota B deixe em branco.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Entrega por e-mail (opcional) ------------------------------------------

# Senha de app do Gmail (não é a senha da conta): https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# --- Ajustes -----------------------------------------------------------------

# Idioma dos artigos e do EPUB (padrão: pt-BR)
# TERRAS_EBOOK_IDIOMA=pt-BR

# Modelo da Anthropic na rota A (padrão: claude-sonnet-4-20250514)
# TERRAS_EBOOK_MODELO=claude-sonnet-4-20250514

# Metadados do EPUB montado pelo export_epub.py
# TERRAS_EBOOK_TITULO=Meu e-book
# TERRAS_EBOOK_AUTOR=Seu Nome
